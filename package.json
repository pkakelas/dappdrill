{
  "name": "dappdrill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @dappdrill/web --filter @dappdrill/worker dev",
    "typecheck": "corepack pnpm -r --parallel typecheck",
    "test": "corepack pnpm -r test",
    "db:generate": "corepack pnpm --filter @dappdrill/db generate",
    "db:migrate": "corepack pnpm --filter @dappdrill/db migrate",
    "fixture": "corepack pnpm --filter @dappdrill/harbor-vault start",
    "fixture:stop": "corepack pnpm --filter @dappdrill/harbor-vault stop",
    "cli": "corepack pnpm --filter @dappdrill/cli exec tsx src/main.ts",
    "drill": "corepack pnpm --filter @dappdrill/engine exec tsx dev/drill.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
