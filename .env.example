# Postgres (Supabase later)
DATABASE_URL=postgres://dappdrill@127.0.0.1:5499/dappdrill
# Encrypts wallet keys and integration secrets at rest
DAPPDRILL_SECRET=change-me-to-a-long-random-string
# Where videos, screenshots and traces are written
ARTIFACTS_DIR=./data/artifacts

# Web app
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# The marketing site (apps/site), allowed to post early access requests
SITE_URL=http://localhost:3100
# Google login turns on when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude. If unset, the engine uses your local Claude Code login (Agent SDK).
ANTHROPIC_API_KEY=
# Thinking model: analyzes apps.
DAPPDRILL_MODEL=claude-opus-5-5
# Fast model: runs test steps, judges results, writes tests and answers the assistant.
DAPPDRILL_FAST_MODEL=claude-sonnet-5-5
# Acting model: takes over steps the fast model can't do.
DAPPDRILL_ACT_MODEL=claude-opus-5-5

# Optional: better contract metadata
ETHERSCAN_API_KEY=

# Optional: email (invites, alerts). Without SMTP, emails are logged to the console.
SMTP_URL=
EMAIL_FROM="DappDrill <alerts@dappdrill.com>"

# Dev: lift plan quotas and treat localhost as a verified domain
DAPPDRILL_DEV=1
