{
  "setup": {
    "startPath": "/",
    "steps": [
      {
        "type": "action",
        "by": "code",
        "do": "Connect the MetaMask wallet.",
        "run": [
          {
            "kind": "click",
            "target": {
              "role": "button",
              "name": "Connect wallet"
            }
          },
          {
            "kind": "click",
            "target": {
              "role": "button",
              "name": "MetaMask",
              "withinDialog": true
            }
          },
          {
            "kind": "wait",
            "until": "text",
            "text": "Your position"
          }
        ]
      },
      {
        "type": "action",
        "by": "code",
        "do": "Click “Get test hUSDC” and approve the request in the wallet, so the wallet holds 1,000 hUSDC.",
        "run": [
          {
            "kind": "click",
            "target": {
              "role": "button",
              "name": "Get test hUSDC"
            }
          },
          {
            "kind": "wallet",
            "respond": "approve"
          },
          {
            "kind": "wait",
            "until": "text",
            "text": "Sent 1,000 test hUSDC to your wallet."
          }
        ]
      }
    ]
  },
  "notes": [
    {
      "text": "Deposit is two wallet requests: approve first (button “Approve N hUSDC”), then the button turns into “Deposit N hUSDC”.",
      "from": "maker"
    },
    {
      "text": "The test wallet starts with 1,000.00 hUSDC; the Vault page is at /vault.",
      "from": "maker"
    },
    {
      "text": "After approving, the deposit button needs no re-entry of the amount; a rejected deposit leaves the 100 in the field and the allowance in place, so retry is a single click on “Deposit 100 hUSDC”.",
      "from": "maker"
    },
    {
      "text": "The wallet starts with nothing in the vault, so a test that needs 100 deposited must deposit first (approve, then deposit).",
      "from": "maker"
    },
    {
      "text": "Balances update on the page right after each transaction is approved; no reload needed.",
      "from": "maker"
    },
    {
      "text": "Rewards are 5% of the deposited position and claimable right after the deposit; claim is a single claim() request with no approve step.",
      "from": "maker"
    }
  ],
  "tests": [
    {
      "id": "deposit-100-husdc-into-the-vault",
      "name": "Deposit 100 hUSDC into the vault",
      "goal": "A user with hUSDC in the wallet deposits 100 of it into the vault.",
      "startPath": "/vault",
      "values": {},
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Type 100 into “Amount to deposit”",
          "run": [
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "Amount to deposit"
              },
              "value": "100"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Approve 100 hUSDC” and approve the request in the wallet",
          "run": [
            {
              "note": "Click \"Approve 100 hUSDC\"",
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Approve 100 hUSDC"
              }
            },
            {
              "note": "Approve eth_sendTransaction to 0x5fbd…0aa3",
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "transaction",
                "to": "0x5fbdb2315678afecb367f032d93f642f64180aa3",
                "functionName": "approve",
                "spenderMustBe": "0xe7f1725e7734ce288f8367e1bb143e90bb3f0512",
                "failIfUnlimited": true
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet was asked to approve 100 hUSDC (100000000) for the vault",
          "expect": {
            "kind": "signed",
            "holds": "approve("
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page says “Approved 100 hUSDC. Now confirm the deposit.” and the button reads “Deposit 100 hUSDC”"
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Deposit 100 hUSDC” and approve the request in the wallet",
          "run": [
            {
              "note": "Deposit 100 hUSDC",
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Deposit 100 hUSDC"
              }
            },
            {
              "note": "Approve eth_sendTransaction to 0xe7f1…0512",
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "transaction",
                "to": "0xe7f1725e7734ce288f8367e1bb143e90bb3f0512",
                "functionName": "deposit"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet was asked to sign deposit(100000000, …) for 100 hUSDC",
          "expect": {
            "kind": "signed",
            "holds": "deposit(100000000"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The deposit transaction was mined",
          "expect": {
            "kind": "mined"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page says “Deposited 100 hUSDC.”"
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet balance shown in the header fell by 100 hUSDC",
          "expect": {
            "kind": "changes",
            "figure": "Wallet:",
            "by": -100
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The “You have … hUSDC deposited” line rose by 100.00 hUSDC",
          "expect": {
            "kind": "changes",
            "figure": "You have",
            "by": 100
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "“Deposited:” under Withdraw rose by 100.00 hUSDC",
          "expect": {
            "kind": "changes",
            "figure": "Deposited:",
            "by": 100
          }
        }
      ],
      "cleanup": []
    },
    {
      "id": "reject-the-vault-deposit-in-the-wallet-then-retry",
      "name": "Reject the vault deposit in the wallet, then retry",
      "goal": "A user who rejects the deposit in the wallet is told so, keeps their hUSDC and can try again.",
      "startPath": "/vault",
      "values": {},
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Type 100 into “Amount to deposit”",
          "run": [
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "Amount to deposit"
              },
              "value": "100"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Approve 100 hUSDC” and approve the request in the wallet",
          "run": [
            {
              "note": "Click Approve 100 hUSDC",
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Approve 100 hUSDC"
              }
            },
            {
              "note": "Approve eth_sendTransaction to 0x5fbd…0aa3",
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "transaction",
                "to": "0x5fbdb2315678afecb367f032d93f642f64180aa3",
                "functionName": "approve",
                "spenderMustBe": "0xe7f1725e7734ce288f8367e1bb143e90bb3f0512",
                "failIfUnlimited": true
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page says “Approved 100 hUSDC. Now confirm the deposit.” and the button reads “Deposit 100 hUSDC”"
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Deposit 100 hUSDC” and reject the request in the wallet",
          "run": [
            {
              "note": "Start the deposit so the wallet asks for it",
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Deposit 100 hUSDC"
              }
            },
            {
              "note": "Reject eth_sendTransaction to 0xe7f1…0512",
              "kind": "wallet",
              "respond": "reject",
              "expect": {
                "kind": "transaction",
                "to": "0xe7f1725e7734ce288f8367e1bb143e90bb3f0512",
                "functionName": "deposit"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page tells the user they rejected the request: “You rejected the request in your wallet.”"
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The wallet balance still reads 1,000.00 hUSDC and the vault shows 0.00 hUSDC deposited, so nothing was taken"
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The “Deposit 100 hUSDC” button is enabled so the user can try again, with 100 still in “Amount to deposit”"
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Deposit 100 hUSDC” again and approve the request in the wallet",
          "run": [
            {
              "note": "Retry the deposit of 100 hUSDC",
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Deposit 100 hUSDC"
              }
            },
            {
              "note": "Approve eth_sendTransaction to 0xe7f1…0512",
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "transaction",
                "to": "0xe7f1725e7734ce288f8367e1bb143e90bb3f0512",
                "functionName": "deposit"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The deposit transaction was mined",
          "expect": {
            "kind": "mined",
            "holds": "deposit("
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page says “Deposited 100 hUSDC.”, the wallet balance reads 900.00 hUSDC and 100.00 hUSDC is shown as deposited"
        }
      ],
      "cleanup": []
    },
