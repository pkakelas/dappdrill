{
  "setup": {
    "startPath": "/",
    "steps": [
      {
        "type": "action",
        "by": "code",
        "do": "Click “Continue with a wallet”, choose MetaMask and approve the sign-in message in the wallet.",
        "run": [
          {
            "kind": "click",
            "target": {
              "role": "button",
              "name": "Continue with a wallet"
            }
          },
          {
            "kind": "click",
            "target": {
              "text": "MetaMask→"
            },
            "optional": true
          },
          {
            "kind": "wallet",
            "respond": "approve",
            "expect": {
              "kind": "message"
            }
          },
          {
            "kind": "wait",
            "until": "text",
            "text": "Portfolio value"
          }
        ]
      }
    ]
  },
  "tests": [
    {
      "id": "withdraw-too-much",
      "name": "Withdrawing more than the account holds is refused",
      "goal": "A user asks to withdraw far more than their cash and is stopped before the wallet is asked.",
      "startPath": "/home",
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Open the Account menu and click “Withdraw”.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Account"
              }
            },
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Withdraw",
                "withinDialog": true
              }
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Type 1000000 into “Withdraw amount”.",
          "run": [
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "Withdraw amount",
                "withinDialog": true
              },
              "value": "1000000"
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The dialog says the amount is more than can be withdrawn.",
          "expect": {
            "kind": "shows",
            "text": "amount exceeds your withdrawable balance"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "Continue can't be clicked.",
          "expect": {
            "kind": "button",
            "name": "Continue",
            "is": "disabled"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The dialog shows how much can be withdrawn, and that figure is not more than the Cash figure on the Home page behind it."
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet wasn't asked for anything.",
          "expect": {
            "kind": "not-signed"
          }
        }
      ]
    },
    {
      "id": "enable-trading-rejected",
      "name": "Rejecting “Enable trading” in the wallet leaves trading off",
      "goal": "A user who declines the trading permission in the wallet is told so, can't trade, and can ask again.",
      "startPath": "/trade/AAPLUSD:perp",
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Click “Enable trading” and reject the request in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Enable trading"
              }
            },
            {
              "kind": "wallet",
              "respond": "reject",
              "expect": {
                "kind": "typedData"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "A notice says the request was rejected.",
          "expect": {
            "kind": "shows",
            "text": "User rejected the request."
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet was asked for the trading permission.",
          "expect": {
            "kind": "signed",
            "holds": "DelegationAuth"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The page doesn't say trading is enabled.",
          "expect": {
            "kind": "hides",
            "text": "trading enabled"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "“Enable trading” can be clicked again.",
          "expect": {
            "kind": "button",
            "name": "Enable trading",
            "is": "enabled"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page shows no raw error: no error code, no stack trace, no “[object Object]”."
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Enable trading” again and approve the request in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Enable trading"
              }
            },
            {
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "typedData"
              }
            },
            {
              "kind": "wait",
              "until": "text",
              "text": "trading enabled"
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The page says trading is enabled.",
          "expect": {
            "kind": "shows",
            "text": "trading enabled"
          }
        }
      ]
    },
    {
      "id": "order-over-limit",
      "name": "An order over the leverage limit is blocked",
      "goal": "A user tries to buy far more AAPL than their margin allows and is stopped before the order is placed.",
      "startPath": "/trade/AAPLUSD:perp",
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Click “Enable trading” and approve the request in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Enable trading"
              }
            },
            {
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "typedData"
              }
            },
            {
              "kind": "wait",
              "until": "text",
              "text": "trading enabled"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Long”, choose USD as the unit and type 900000 as the amount.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Long"
              }
            },
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "USD"
              }
            },
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "0.00"
              },
              "value": "900000"
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The form says the order is over the limit.",
          "expect": {
            "kind": "shows",
            "text": "Over your 5x limit"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The button that places the order can't be clicked.",
          "expect": {
            "kind": "button",
            "name": "Long AAPL/USD",
            "is": "disabled"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The order form shows the most the user could buy, and 900,000 USD is more than that."
        }
      ]
    },
    {
      "id": "home-adds-up",
      "name": "Home's figures agree with each other",
      "goal": "A user reading Home sees totals that follow from the rows under them.",
      "startPath": "/home",
      "steps": [
        {
          "type": "check",
          "by": "llm",
          "claim": "Portfolio value equals Cash plus Unrealized P&L, give or take two cents."
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "Position value equals the sum of the Value column of the rows under Holdings, give or take two cents, and the number beside the Holdings tab is the number of rows."
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "Margin available is not more than Cash, and the share of equity in use is consistent with the two (0% only when they are within a few dollars of each other)."
        }
      ]
    },
    {
      "id": "limit-cancel",
      "name": "Place a resting limit order and cancel it",
      "goal": "A user places a limit buy for AAPL far below the market, finds it resting in their orders, and cancels it.",
      "startPath": "/trade/AAPLUSD:perp",
      "values": {
        "price": {
          "from": 150,
          "to": 180,
          "decimals": 2
        }
      },
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Click “Enable trading” and approve the request in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Enable trading"
              }
            },
            {
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "typedData"
              }
            },
            {
              "kind": "wait",
              "until": "text",
              "text": "trading enabled"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Long”, choose USD as the unit and type 100 as the amount.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Long"
              }
            },
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "USD"
              }
            },
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "0.00"
              },
              "value": "100"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Type {{price}} into the Price field of the order form, so the order is a limit order at {{price}}.",
          "run": [
            {
              "kind": "fill",
              "target": {
                "near": "Est."
              },
              "value": "{{price}}"
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The order form shows a limit order, not a market one: a long of 100 USD of AAPL at a price of {{price}}."
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Long AAPL/USD” to place the order.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Long AAPL/USD"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page confirms the order was placed and shows no error."
        },
        {
          "type": "action",
          "by": "code",
          "do": "Open Home afresh and its Orders tab.",
          "run": [
            {
              "kind": "goto",
              "url": "/home"
            },
            {
              "kind": "click",
              "target": {
                "role": "tab",
                "name": "Orders"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The orders list has an Apple BUY LIMIT order at ${{price}}, its status is Open, and its size times its price is 100 USD, give or take a cent."
        },
        {
          "type": "action",
          "by": "llm",
          "do": "Cancel the Apple order priced ${{price}} and no other: click Cancel on its row, and approve the wallet request if one comes."
        },
        {
          "type": "action",
          "by": "code",
          "do": "Open Home afresh and its Orders tab.",
          "run": [
            {
              "kind": "goto",
              "url": "/home"
            },
            {
              "kind": "click",
              "target": {
                "role": "tab",
                "name": "Orders"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The Apple BUY LIMIT order at ${{price}} shows as Cancelled."
        }
      ],
      "cleanup": [
        {
          "type": "action",
          "by": "code",
          "do": "Open Home afresh and its Orders tab.",
          "run": [
            {
              "kind": "goto",
              "url": "/home"
            },
            {
              "kind": "click",
              "target": {
                "role": "tab",
                "name": "Orders"
              }
            }
          ]
        },
        {
          "type": "action",
          "by": "llm",
          "do": "If an Apple order priced ${{price}} is listed as Open, cancel it with Cancel on its row and approve the wallet request. If there is none, there is nothing to do."
        }
      ]
    },
