    {
      "id": "withdraw",
      "name": "Withdraw to the connected wallet",
      "goal": "A user takes ${{amount}} of their cash out to the wallet they signed in with.",
      "startPath": "/home",
      "values": {
        "amount": {
          "from": 20,
          "to": 21,
          "decimals": 2
        }
      },
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Open the Account menu and click “Withdraw”.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Account"
              }
            },
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Withdraw",
                "withinDialog": true
              }
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Type {{amount}} into “Withdraw amount” and click “Continue”.",
          "run": [
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "Withdraw amount",
                "withinDialog": true
              },
              "value": "{{amount}}"
            },
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Continue",
                "withinDialog": true
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page asks where to send ${{amount}} and offers the connected wallet, 0x5bfF…4d8a, as a destination."
        },
        {
          "type": "action",
          "by": "code",
          "do": "Choose “My connected wallet” and approve the transaction in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "text": "My connected wallet0x5bfF…4d8a→",
                "withinDialog": true
              }
            },
            {
              "kind": "wallet",
              "respond": "approve",
              "expect": {
                "kind": "transaction",
                "to": "0x50d0000000000000000000000000000000000001"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet was asked to send a transaction to pod's withdraw contract.",
          "expect": {
            "kind": "signed",
            "holds": "0x50d0000000000000000000000000000000000001"
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The withdrawal was mined and didn't revert.",
          "expect": {
            "kind": "mined",
            "holds": "0x50d0000000000000000000000000000000000001"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page says the withdrawal of ${{amount}} was submitted or is on its way, and shows no error."
        },
        {
          "type": "check",
          "by": "code",
          "claim": "Cash on Home fell by {{amount}}.",
          "expect": {
            "kind": "changes",
            "figure": "Cash",
            "by": "-{{amount}}",
            "on": "/home"
          }
        }
      ]
    },
    {
      "id": "deposit-rejected",
      "name": "Rejecting a deposit in the wallet queues nothing",
      "goal": "A user starts a $25 deposit from their wallet, declines it in the wallet, and nothing is taken or queued.",
      "startPath": "/home",
      "steps": [
        {
          "type": "action",
          "by": "code",
          "do": "Click “Add funds” and type 25 into “Deposit amount”.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Add funds"
              }
            },
            {
              "kind": "fill",
              "target": {
                "role": "textbox",
                "name": "Deposit amount",
                "withinDialog": true
              },
              "value": "25"
            }
          ]
        },
        {
          "type": "action",
          "by": "code",
          "do": "Click “Continue”, choose “Deposit $25 from your wallet” and reject the request in the wallet.",
          "run": [
            {
              "kind": "click",
              "target": {
                "role": "button",
                "name": "Continue",
                "withinDialog": true
              }
            },
            {
              "kind": "click",
              "target": {
                "text": "Deposit $25 from your wallet"
              }
            },
            {
              "kind": "wallet",
              "respond": "reject",
              "expect": {
                "kind": "typedData"
              }
            }
          ]
        },
        {
          "type": "check",
          "by": "code",
          "claim": "A notice says the request was rejected.",
          "expect": {
            "kind": "shows",
            "text": "User rejected the request."
          }
        },
        {
          "type": "check",
          "by": "code",
          "claim": "The wallet was asked to sign a permit for the deposit.",
          "expect": {
            "kind": "signed",
            "holds": "Permit"
          }
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The wallet request for the deposit was rejected, not approved, and the permit it was asked for was for 25 USDC and no more."
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The user can try again: “Deposit $25 from your wallet” is still offered and isn't greyed out or stuck loading."
        },
        {
          "type": "check",
          "by": "llm",
          "claim": "The page shows no raw error (no error code, no stack trace) and doesn't say a deposit was made."
        },
        {
          "type": "check",
          "by": "code",
          "claim": "Cash on Home didn't move.",
          "expect": {
            "kind": "changes",
            "figure": "Cash",
            "by": 0,
            "on": "/home"
          }
        }
      ]
    },
